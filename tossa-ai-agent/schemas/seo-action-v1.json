{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEO Action",
  "description": "A single proposed SEO action from the AI agent.",
  "type": "object",
  "required": ["action_id", "action_type", "safety_tier", "rationale", "payload"],
  "properties": {
    "action_id": {
      "type": "string",
      "description": "Unique identifier for this action."
    },
    "action_type": {
      "type": "string",
      "enum": [
        "set_meta_title", "set_meta_description", "set_canonical", "set_robots",
        "set_social_title", "set_social_description", "set_focus_keyword",
        "set_noindex", "set_nofollow", "fix_missing_meta",
        "rewrite_heading", "rewrite_intro", "rewrite_section",
        "insert_internal_link", "remove_internal_link",
        "add_faq_schema", "update_schema", "suggest_alt_text",
        "bulk_rewrite", "page_consolidation", "redirect_strategy",
        "new_landing_page", "multilingual_restructure", "delete_page",
        "change_url_structure", "modify_business_claims"
      ]
    },
    "entity_type": {
      "type": "string",
      "enum": ["post", "page", "product", "term", "archive", "global"],
      "default": "post"
    },
    "entity_id": {
      "type": ["integer", "null"],
      "description": "WordPress post/term ID. Null for global actions."
    },
    "safety_tier": {
      "type": "string",
      "enum": ["A", "B", "C"],
      "description": "A=safe reversible, B=editorial review, C=human-only."
    },
    "evidence_source": {
      "type": "string",
      "enum": ["gsc", "psi", "crawl", "wp_content", "manual_rule", "llm_inference"],
      "description": "What data informed this recommendation."
    },
    "rationale": {
      "type": "string",
      "description": "Why this action is recommended."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "AI confidence in this recommendation (0.0 to 1.0)."
    },
    "expected_impact": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "target_metric": {
      "type": "string",
      "description": "The metric this action aims to improve.",
      "examples": ["CTR", "avg_position", "indexability", "internal_links", "title_uniqueness", "CWV"]
    },
    "payload": {
      "type": "object",
      "description": "Action-specific data. Structure depends on action_type.",
      "additionalProperties": true
    },
    "before": {
      "type": "object",
      "description": "Current state snapshot.",
      "additionalProperties": true
    }
  }
}
