# Tossa VPS Agent — Environment Variables
# Copy to .env and fill in values.

# Required
ANTHROPIC_API_KEY=sk-ant-...
WORDPRESS_CALLBACK_URL=https://your-staging-site.com/wp-json/tossa-agent/v1/callback
WEBHOOK_SHARED_SECRET=generate-this-in-wordpress-settings

# Optional
PORT=3100
CLAUDE_MODEL=claude-sonnet-4-6
LOG_LEVEL=info
