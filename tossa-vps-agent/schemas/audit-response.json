{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEO Audit Response",
  "description": "Expected response format from Claude SEO audit.",
  "type": "object",
  "required": ["summary", "overall_score", "issues", "actions"],
  "properties": {
    "summary": { "type": "string" },
    "overall_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["issue_type", "severity", "description"],
        "properties": {
          "issue_type": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "warning", "info"] },
          "description": { "type": "string" },
          "entity_type": { "type": "string" },
          "entity_id": { "type": ["integer", "null"] },
          "evidence_source": { "type": "string" }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action_type", "entity_id", "rationale", "payload"],
        "properties": {
          "action_id": { "type": "string" },
          "action_type": { "type": "string" },
          "entity_type": { "type": "string", "default": "post" },
          "entity_id": { "type": "integer" },
          "safety_tier": { "type": "string", "enum": ["A", "B", "C"] },
          "evidence_source": { "type": "string" },
          "rationale": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "expected_impact": { "type": "string", "enum": ["low", "medium", "high"] },
          "target_metric": { "type": "string" },
          "payload": { "type": "object" },
          "before": { "type": "object" }
        }
      }
    }
  }
}
