# WordPress Playwright Configuration
# Copy this file to .env.playwright and fill in your values

# WordPress site URL (staging recommended)
WP_BASE_URL=https://staging.lukaszkomar.com

# WordPress admin credentials (for authenticated tests)
WP_ADMIN_USER=your-admin-username
WP_ADMIN_PASS=your-admin-password

# WordPress REST API Application Password (for API-based tests)
WP_API_USER=your-admin-username
WP_API_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
